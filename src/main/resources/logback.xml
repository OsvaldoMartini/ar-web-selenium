<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">

    <!-- Disable all Logback internal status messages -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- Dynamic log path: use system property LOG_PATH, default to ./logs -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>

    <!-- Console Appender -->
<!--    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">-->
<!--        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">-->
<!--            <pattern>%white(%d{ISO8601}) %highlight(%-5level) [%blue(%t)] %yellow(%C{1}): %msg%n%throwable</pattern>-->
<!--        </encoder>-->
<!--    </appender>-->

    <!-- Rolling File Appender (main logs) -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ar_web_scanner_base.log</file>
        <prudent>true</prudent>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
<!--            <pattern>%d{ISO8601} %-5p %C{1} [%t] %m%n%throwable</pattern>-->
            <pattern>%d{ISO8601} %m%n%throwable</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ar_web_scanner_base-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Special Rolling File Appender -->
    <appender name="LAUNCH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ar_web_scan_scanner_execution.log</file>
        <prudent>true</prudent>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{ISO8601} %m%n%throwable</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ar_web_scanner_execution-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Database Rolling File Appender -->
    <appender name="DATABASE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ar_web_scanner_database.log</file>
        <prudent>true</prudent>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{ISO8601} %m%n%throwable</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ar_web_scanner_database-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Web Operations Rolling File Appender -->
    <appender name="WEB_OPERATIONS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ar_web_scanner_operations.log</file>
        <prudent>true</prudent>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{ISO8601} %m%n%throwable</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ar_web_scanner_operations-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Scanner Rolling File Appender — OCR pipeline runs + Test On Current Page summaries -->
    <appender name="SCANNER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ar_web_scanner_web_elemets.log</file>
        <prudent>true</prudent>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{ISO8601} %m%n%throwable</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ar_web_scanner_web_elemets-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Backend Rolling File Appender — incoming WebSocket verbs (who calls the backend,
         how often). One line per request: verb + session + owner ids. Use this file to
         spot runaway request loops (e.g. a client re-sending a verb many times/second). -->
    <appender name="BACKEND_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ar_web_scanner_backend.log</file>
        <prudent>true</prudent>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{ISO8601} %m%n%throwable</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ar_web_scanner_backend-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Suppress Jetty logs completely -->
    <logger name="org.eclipse.jetty" level="OFF" additivity="false"/>
    <logger name="org.eclipse.jetty.util.log" level="OFF" additivity="false"/>
    <logger name="org.eclipse.jetty.server" level="OFF" additivity="false"/>
    <logger name="org.eclipse.jetty.websocket" level="OFF" additivity="false"/>

    <!-- Suppress HSQLDB internal logging -->
    <logger name="org.hsqldb" level="OFF" additivity="false"/>

    <!-- Example: Trace logging for a specific package -->
    <logger name="com.allinweb.ch.component.pane" level="TRACE" additivity="false">
   <!--        <appender-ref ref="CONSOLE"/>-->
        <appender-ref ref="ROLLING_FILE"/>
    </logger>

    <!-- Logger for special usage -->
    <logger name="com.allinweb.launch" level="DEBUG" additivity="false">
        <appender-ref ref="LAUNCH_FILE"/>
    </logger>

    <!-- Logger for DATABASE-specific classes -->
    <logger name="com.allinweb.database" level="DEBUG" additivity="false">
        <appender-ref ref="DATABASE_FILE"/>
    </logger>

    <!-- Logger for Web operations / element handling -->
    <logger name="com.allinweb.operations" level="DEBUG" additivity="false">
        <appender-ref ref="WEB_OPERATIONS_FILE"/>
    </logger>

    <!-- Logger for OCR / scanner pipeline events (PageOcrDumper runs, Test On Current Page summaries) -->
    <logger name="com.allinweb.scanner" level="INFO" additivity="false">
        <appender-ref ref="SCANNER_FILE"/>
    </logger>

    <!-- Logger for backend WebSocket request traffic -->
    <logger name="com.allinweb.backend" level="INFO" additivity="false">
        <appender-ref ref="BACKEND_FILE"/>
    </logger>

    <!-- In-memory ring buffer of last N log lines, read by SupportCapture
         when uploading a DOM capture. Adds no I/O. -->
    <appender name="RINGBUFFER" class="com.allinweb.ch.util.ConsoleRingBufferAppender"/>

    <!-- Root Logger -->
    <root level="INFO">
<!--        <appender-ref ref="CONSOLE"/>-->
        <appender-ref ref="ROLLING_FILE"/>
        <appender-ref ref="RINGBUFFER"/>
    </root>

</configuration>
