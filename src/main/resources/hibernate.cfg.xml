<hibernate-configuration>
    <session-factory>
        <property name="hibernate.dialect">net.ucanaccess.hibernate.dialect.UCanAccessDialect</property>
        <property name="hibernate.connection.driver_class">net.ucanaccess.jdbc.UcanaccessDriver</property>
        <property name="hibernate.globally_quoted_identifiers">true</property>
        <property name="hibernate.naming.physical-strategy">org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl</property>

        <property name="connection_pool_size">1</property>

        <!-- Automatically drop and create tables on startup -->
<!--        <property name="hibernate.hbm2ddl.auto">create-drop</property>-->
        <property name="hbm2ddl.auto">update</property>
        <property name="show_sql">true</property>

        <mapping class="com.allinweb.ch.persistence.VariableDTO"/>
        <mapping class="com.allinweb.ch.persistence.ConfigurationDTO"/>
        <mapping class="com.allinweb.ch.persistence.BaseDTO"/>
        <mapping class="com.allinweb.ch.persistence.HomeBankingDTO"/>
        <mapping class="com.allinweb.ch.persistence.BotJobDTO"/>
        <mapping class="com.allinweb.ch.persistence.BlockDTO"/>
        <mapping class="com.allinweb.ch.persistence.BlockLoopInstructionDTO"/>
        <mapping class="com.allinweb.ch.persistence.ComplexInstructionDTO"/>
        <mapping class="com.allinweb.ch.persistence.InstructionReferenceDTO"/>
        <mapping class="com.allinweb.ch.persistence.SavedBlocksDTO"/>
        <mapping class="com.allinweb.ch.persistence.SavedBlockLoopInstructionDTO"/>
        <mapping class="com.allinweb.ch.persistence.SavedInstructionReferenceDTO"/>
    </session-factory>
</hibernate-configuration>